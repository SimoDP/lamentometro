# Percorso del database SQLite (nel container è già /data/lamentometro.db)
DATABASE_PATH=/data/lamentometro.db

# Email per il PIN di recupero password (es. Brevo, Resend, Gmail con password per app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lamentometro <noreply@miodominio.it>"

# Notifiche push: genera le chiavi con `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tua@email.it
